# Absolute host path to the network folder. Docker Compose mounts it read-only.
ESG_INPUT_DIR=/mnt/network/extended_service_goal
ESG_ARCHIVE_INPUT_DIR=/mnt/network/extended_service_goal_archive
ESG_INPUT_EXTENSIONS=.docx
ESG_INPUT_FILENAME_TOKENS=TR,SR
ESG_SEARCH_FILENAME_TOKENS=TR,SR
ESG_MARKDOWN_DIR=/app/source_documents
ESG_MARKDOWN_ONLY_INGESTION=true
ESG_RUNTIME_DIR=/app/runtime
ESG_SOURCE_LINK_ROOT=P:/Example/Deliverables
ESG_SOURCE_LINK_ROOTS={"archive":"//fileserver/share/archive"}
ESG_API_HOST=0.0.0.0
ESG_API_PORT=8132
ESG_MODEL_ID=esg-repair-search

ESG_QDRANT_URL=http://qdrant:6333
ESG_QDRANT_COLLECTION=esg_repair_documents_v1
ESG_OLLAMA_URL=http://ollama:11434
ESG_EMBEDDING_API=ollama
ESG_EMBEDDING_MODEL=bge-m3
ESG_EMBEDDING_BATCH_SIZE=16

ESG_LLM_BASE_URL=http://host.docker.internal:1234/v1
ESG_LLM_API_KEY=local
ESG_LLM_MODEL=
ESG_LLM_TIMEOUT_SECONDS=120
ESG_LLM_MAX_TOKENS=4000
ESG_QUERY_EXTRACTION_ENABLED=false
ESG_QUERY_LLM_BASE_URL=
ESG_QUERY_LLM_MODEL=esg-query-extractor
ESG_QUERY_LLM_TIMEOUT_SECONDS=15
ESG_CHUNK_EXTRACTION_ENABLED=false
ESG_CHUNK_EXTRACTION_MAX_CHARS=5000
ESG_CHUNK_EXTRACTION_WORKERS=2
ESG_REPAIR_CHUNK_MAX_CHARS=5000

ESG_RERANKER_URL=
ESG_RERANKER_TIMEOUT_SECONDS=60
ESG_RERANKER_BATCH_SIZE=8
ESG_RETRIEVAL_TOP_K=40
ESG_FINAL_TOP_K=6
ESG_SHOW_RETRIEVED_CHUNKS=false
ESG_RRF_K=60

MINERU_BACKEND=pipeline
MINERU_METHOD=txt
MINERU_LANG=cyrillic
MINERU_TIMEOUT_SECONDS=1800
ESG_DIRECT_DOCX_ENABLED=true
